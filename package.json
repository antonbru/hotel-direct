{
  "name": "hotel-direct",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Расширение Chrome, Яндекс Браузера и Opera: на агрегаторе показывает официальный сайт и телефон отеля из реестра Росаккредитации.",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "validate": "node scripts/validate-manifest.mjs",
    "syntax": "node scripts/check-syntax.mjs",
    "icons": "python3 scripts/make-icons.py",
    "build": "bash scripts/build.sh",
    "check": "npm run syntax && npm run validate && npm test",
    "live": "node scripts/live-check.mjs",
    "promo": "node scripts/render-promo.mjs",
    "store:capture": "node scripts/store-capture.mjs",
    "store:shots": "node scripts/store-shots.mjs",
    "promo:opera": "node scripts/render-opera-promo.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright-core": "^1.49.0"
  }
}
